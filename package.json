{
  "name": "agent-loop-guard",
  "version": "0.1.0",
  "description": "Host-agnostic repetition and tool-loop hard-trip guards for LLM agents. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node tests/node/run-all.mjs",
    "test:vitest": "vitest run",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "keywords": [
    "llm",
    "agent",
    "anti-repetition",
    "tool-loop",
    "streaming",
    "guard"
  ],
  "author": "agent-loop-guard contributors",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shu0819-sjy/agent-loop-guard.git"
  },
  "bugs": {
    "url": "https://github.com/shu0819-sjy/agent-loop-guard/issues"
  },
  "homepage": "https://github.com/shu0819-sjy/agent-loop-guard#readme"
}
